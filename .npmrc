# Why legacy-peer-deps:
# npm v7+ enforces peer ranges strictly. @angular/fire@20.0.1 (the latest
# available release) only declares peers for @angular/*@^20, while this app
# targets Angular 22. No @angular/fire release supports Angular 22 yet, and
# this exact combination (Angular 22 + @angular/fire 20.0.1) is validated to
# build and run. Opt out of strict peer resolution until @angular/fire@22
# ships. This also lets `npm ci` pass in GitHub Actions.
legacy-peer-deps=true
